// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  user
  admin
  petugas
}

enum DisasterType {
  flood
  fire
  fallen_tree
  landslide
  earthquake
  other
}

enum RoadIssueType {
  pothole
  landslide
  bridge_damage
  crack
  flooding
}

enum ReportStatus {
  pending
  verified
  in_progress
  resolved
}

enum RiskLevel {
  low
  medium
  high
  critical
}

enum DangerLevel {
  minor
  moderate
  severe
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String // Hashed password
  phone     String?
  role      UserRole @default(user)
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  disasterReports DisasterReport[] @relation("ReportedDisasters")
  roadReports     RoadReport[]     @relation("ReportedRoads")
  assignedDisasters DisasterReport[] @relation("AssignedDisasters")
  assignedRoads     RoadReport[]     @relation("AssignedRoads")
  comments        Comment[]
  activities      ReportActivity[]
  sessions        Session[]

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("sessions")
}

model DisasterReport {
  id          String       @id @default(cuid())
  type        DisasterType
  title       String
  description String
  address     String
  lat         Float
  lng         Float
  district    String
  images      String[]     @default([])
  status      ReportStatus @default(pending)
  riskLevel   RiskLevel    @default(medium)
  urgencyPercentage Float?  @default(0) // Persentase tingkat bahaya/urgensi (0-100)

  // User relation (optional for anonymous reports)
  reportedById String?
  reportedBy   User?   @relation("ReportedDisasters", fields: [reportedById], references: [id], onDelete: SetNull)

  // Anonymous reporter info (if no user logged in)
  reporterName  String?
  reporterPhone String?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation("AssignedDisasters", fields: [assignedToId], references: [id], onDelete: SetNull)

  handledBy String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  activities    ReportActivity[]

  @@map("disaster_reports")
}

model RoadReport {
  id          String        @id @default(cuid())
  type        RoadIssueType
  title       String
  description String
  address     String
  lat         Float
  lng         Float
  district    String
  images      String[]      @default([])
  status      ReportStatus  @default(pending)
  dangerLevel DangerLevel   @default(moderate)
  urgencyPercentage Float?  @default(0) // Persentase tingkat bahaya/urgensi (0-100)

  // User relation (optional for anonymous reports)
  reportedById String?
  reportedBy   User?   @relation("ReportedRoads", fields: [reportedById], references: [id], onDelete: SetNull)

  // Anonymous reporter info (if no user logged in)
  reporterName  String?
  reporterPhone String?

  // Assignment
  assignedToId String?
  assignedTo   User?   @relation("AssignedRoads", fields: [assignedToId], references: [id], onDelete: SetNull)

  // AI Analysis fields (optional)
  aiDetectedIssues    String[]
  aiConfidence        Float?
  aiRecommendedAction String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments      Comment[]
  activities    ReportActivity[]

  @@map("road_reports")
}

model Comment {
  id               String          @id @default(cuid())
  reportId         String
  reportType       String // 'disaster' or 'road'
  content          String
  authorId         String
  author           User            @relation(fields: [authorId], references: [id])
  createdAt        DateTime        @default(now())
  DisasterReport   DisasterReport? @relation(fields: [disasterReportId], references: [id])
  disasterReportId String?
  RoadReport       RoadReport?     @relation(fields: [roadReportId], references: [id])
  roadReportId     String?

  @@map("comments")
}

enum ActivityType {
  assigned
  status_changed
  verified
  in_progress
  resolved
  note_added
  comment_added
}

model ReportActivity {
  id               String          @id @default(cuid())
  reportId         String
  reportType       String // 'disaster' or 'road'
  activityType     ActivityType
  description      String
  images           String[]        @default([]) // Optional images for activity log
  metadata         Json?           // Additional data (e.g., old status, new status)
  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])
  createdAt        DateTime        @default(now())
  DisasterReport   DisasterReport? @relation(fields: [disasterReportId], references: [id], onDelete: Cascade)
  disasterReportId String?
  RoadReport       RoadReport?     @relation(fields: [roadReportId], references: [id], onDelete: Cascade)
  roadReportId     String?

  @@map("report_activities")
  @@index([reportId, reportType])
  @@index([createdAt])
}
